{
  "eos_cli_config_gen": {
    "type": "dict",
    "keys": {
      "aaa_authentication": {
        "type": "dict",
        "keys": {
          "login": {
            "type": "dict",
            "keys": {
              "default": {
                "type": "str",
                "description": "Login authentication method(s) as a string."
              },
              "command_api": {
                "type": "str",
                "description": "Command-API authentication method(s) as a string."
              },
              "console": {
                "type": "str",
                "description": "Console authentication method(s) as a string."
              }
            }
          }
        }
      }
    },
    "$defs": {
      "methods": {
        "type": "list",
        "min_length": 1,
        "items": {
          "type": "dict",
          "keys": {
            "method": {
              "type": "str",
              "required": true,
              "valid_values": [
                "logging",
                "group"
              ]
            },
            "group": {
              "type": "str",
              "description": "Specify the server group to be used.\nThis option is applicable only when the `method` key is explicitly set to `group`."
            }
          }
        }
      }
    }
  },
  "schema_documentation_fixture": {
    "type": "dict",
    "keys": {
      "profiles": {
        "type": "list",
        "description": "Reusable profiles.\nSecond line.",
        "primary_key": "name",
        "min_length": 1,
        "max_length": 5,
        "default": [
          {
            "name": "default",
            "settings": {
              "long_value": "flexible exact-match 16384 l2-shared 98304 l3-shared 131072"
            }
          }
        ],
        "items": {
          "type": "dict",
          "keys": {
            "name": {
              "type": "str",
              "description": "Profile name."
            },
            "priority": {
              "type": "int",
              "min": 1,
              "max": 100,
              "valid_values": [
                10,
                20
              ],
              "default": 10
            },
            "mode": {
              "type": "str",
              "min_length": 2,
              "max_length": 20,
              "format": "ipv4",
              "convert_to_lower_case": true,
              "valid_values": [
                "active",
                "passive"
              ],
              "dynamic_valid_values": [
                "custom_modes"
              ],
              "pattern": "^[a-z]+$",
              "deprecation": {
                "warning": true,
                "new_key": "state",
                "remove_in_version": "7.0.0",
                "url": "https://example.invalid/mode"
              }
            },
            "removed": {
              "type": "str",
              "deprecation": {
                "warning": true,
                "removed": true,
                "new_key": "state"
              }
            },
            "opaque": {
              "type": "dict",
              "default": {
                "enabled": true
              },
              "documentation_options": {
                "hide_keys": true
              },
              "keys": {
                "enabled": {
                  "type": "bool"
                }
              }
            }
          }
        }
      },
      "standalone_value": {
        "type": "str",
        "required": true,
        "default": "value",
        "documentation_options": {
          "table": "standalone"
        }
      }
    },
    "dynamic_keys": {
      "network_services_keys.name": {
        "type": "list",
        "documentation_options": {
          "table": "dynamic-profiles"
        },
        "items": {
          "type": "str"
        }
      }
    }
  },
